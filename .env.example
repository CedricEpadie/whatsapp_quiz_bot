# Qui peut lancer .quizz :
#   linkedAccount (défaut) -> seul le compte WhatsApp lié au bot (celui
#     qui a scanné le QR code) peut lancer une partie
#   everyone -> tout le monde dans le groupe peut lancer .quizz
QUIZZ_ACCESS_MODE=linkedAccount

# Dossier où Baileys stocke les identifiants de session (auto-créé)
AUTH_FOLDER=./auth_info

# Chemin du fichier SQLite (auto-créé au premier lancement)
DB_PATH=./data/quiz.db

# Délai (ms) toléré avant d'annuler une partie en cours suite à une
# coupure de connexion du bot
DISCONNECT_CANCEL_TIMEOUT_MS=15000

# Identifiants de connexion à Mega (pour sauvegarder/restaurer la session)
MEGA_EMAIL=youremailmega@gmail.com
MEGA_PASSWORD=yourpasswordmega

# Variables de sessions
SESSION_HANDLE=
SESSION_KEY=